{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jqradar:schema:report:3",
  "title": "jqradar report.json",
  "description": "`jqradar scan`의 산출물 — 지도(§3). §7의 통합 JSON 스키마 스케치를 기계 검증 가능하게 옮긴 것이다. 이 문서의 예시는 `contract/lens/sample-service/expected.json` 픽스처이며 CI가 measures로부터 재계산해 대조한다(§7 머리말, D26).",
  "type": "object",
  "required": [
    "schema",
    "project",
    "reproduce",
    "population",
    "system",
    "components",
    "files",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "jqradar/3",
      "description": "스키마 버전(§7). `analysis_input_id`의 입력이기도 하다(§2.8)."
    },
    "project": {
      "type": "string",
      "description": "프로젝트 이름(§7). 설명이며 재계산 대상이 아니다."
    },
    "reproduce": {
      "$ref": "#/$defs/reproduce"
    },
    "population": {
      "$ref": "#/$defs/population"
    },
    "system": {
      "$ref": "#/$defs/system"
    },
    "components": {
      "type": "array",
      "description": "컴포넌트 단위 Martin 지표(§2.2). 계산은 ArchUnit `ArchitectureMetrics.componentDependencyMetrics`(D3).",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "files": {
      "type": "array",
      "description": "파일 단위 측정·백분위·렌즈(§2.1, §2.5, §3).",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "duplicate_clusters": {
      "type": "array",
      "description": "중복 클러스터(§2.6, D39) — 같은 정규화 토큰 열의 모든 발생. 쌍이 아니라 클러스터가 단위다.",
      "items": {
        "$ref": "#/$defs/duplicateCluster"
      }
    },
    "duplication_pairs": {
      "type": "array",
      "description": "쌍별 중복 토큰 투영(§2.6). `pair_dup_tokens`는 A쪽 구간 합집합이며 A = 경로 사전순 앞.",
      "items": {
        "$ref": "#/$defs/duplicationPair"
      }
    },
    "hidden_couplings": {
      "type": "array",
      "description": "숨은 결합 목록(§2.4, §3.5) — 점수가 아니라 목록이다. `shared ≥ 5 ∧ tc ≥ 0.5`.",
      "items": {
        "$ref": "#/$defs/hiddenCoupling"
      }
    },
    "findings": {
      "type": "array",
      "description": "발견(§3.7, D22) — `priority · interpretation · confidence · evidence`. 점수·순위·심각도가 아니다(B.2).",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "nullableNumber": {
      "type": [
        "number",
        "null"
      ]
    },
    "percentileValue": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1,
      "description": "백분위 `pct(x) = (rank_avg(x) − 1)/(N − 1)`(§2.5). N = 1 또는 N < `percentile.min_population`이면 null. **계산은 정확 유리수, 직렬화는 소수 4자리 HALF_EVEN**(§2.5 산술 계약, D115) — 임계 비교(`pct ≥ 0.90`)는 반올림 전 값으로 한다."
    },
    "populationName": {
      "enum": [
        "active",
        "dx",
        "all"
      ],
      "description": "모집단 셋(§2.5, D24) — `active`(W 안 chg_commits ≥ 1, H) / `dx`(active ∩ twins ≥ 1, Dx) / `all`(모든 적격 main 소스, F)."
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "§3.7. `low ⇔ N < 50 ∨ IQR = 0 ∨ (median > 0 ∧ IQR < 0.25·median) ∨ (coarse ∧ 성분 = chg_commits)`; `high ⇔ N ≥ 200 ∧ low 조건 없음`; 그 외 `medium`. 렌즈 confidence = 기여 성분의 최소(D28)."
    },
    "interpretation": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "investigate_first",
        "investigate",
        "context",
        null
      ],
      "description": "§3.7. 렌즈 백분위 `≥ 0.90` → `investigate_first`, `≥ 0.75` → `investigate`, 그 외 `context`. 렌즈 값이 null이면 null. 렌즈 백분위만 쓰며 절대 임계가 아니다(D34)."
    },
    "reproduce": {
      "type": "object",
      "description": "재현 블록(§2.8, D10). 원칙 둘: 여기 포함되지 않은 입력은 결과에 영향을 주어서는 안 되고, `analysis_input_id`에 포함된 모든 입력은 여기에 값 또는 해시로 나타나야 한다(D111).",
      "required": [
        "tool_version",
        "schema_version",
        "contract_version",
        "window_anchor",
        "head",
        "repository_state_id",
        "analysis_input_id",
        "environment",
        "history_backend",
        "window_applied",
        "component",
        "parameters",
        "percentile_method",
        "algorithm_versions",
        "classes_id"
      ],
      "properties": {
        "tool_version": {
          "type": "string",
          "description": "jQRadar 버전(§2.8 `core_tool_version`). major.minor.patch."
        },
        "schema_version": {
          "type": "string",
          "description": "산출물 스키마 버전(§2.8) — `analysis_input_id` 입력."
        },
        "contract_version": {
          "type": "string",
          "description": "측정 계약(§2) 버전(§2.8) — `analysis_input_id` 입력. 계약이 바뀌면 캐시가 적중해서는 안 된다."
        },
        "scanned_at": {
          "type": "string",
          "description": "실행 시각(§2.7). **감사 메타데이터일 뿐 계산에 들어가지 않는다** — 시간 기준은 `window_anchor`다(D25)."
        },
        "algorithm_versions": {
          "type": "object",
          "description": "측정·컴포넌트 전략 알고리즘 버전(§2.8) — `analysis_input_id` 입력. 공식이 바뀌면 트리가 같아도 결과가 다르다.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "window_anchor": {
          "type": "object",
          "description": "시간 앵커(§2.7, D25) = HEAD 커밋의 커미터 시각. 모든 '최근'·'경과'가 이 시각 기준이라 같은 HEAD를 언제 재도 같은 값이 나온다.",
          "required": [
            "type",
            "timestamp"
          ],
          "properties": {
            "type": {
              "const": "head_committer_time"
            },
            "timestamp": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "head": {
          "type": "string",
          "description": "HEAD 커밋 SHA(§2.7)."
        },
        "repository_state_id": {
          "type": "string",
          "description": "정렬된 `(path, content_id)` 전체의 sha256(§2.8). 트리의 정체성이며 캠페인 앵커의 봉인(D88·D112). 형식은 `sha256:<hex>`."
        },
        "analysis_input_id": {
          "type": "string",
          "description": "툴체인·계약·입력 전부의 sha256(§2.8, D87). **캐시 키**. 형식은 `sha256:<hex>`."
        },
        "classes_id": {
          "type": "string",
          "description": "`bytecode_scope` 안 `.class` 파일의 정렬된 `(상대 경로, bytes)` sha256(§2.8). 지표 재현에는 이 값만으로 충분하다."
        },
        "environment": {
          "type": "object",
          "description": "분석 도구 버전(§2.8). major.minor.patch. `analysis_input_id` 입력 — 빠지면 PMD 7.16과 7.17이 같은 캐시 키를 만든다.",
          "required": [
            "pmd",
            "archunit",
            "jgit"
          ],
          "properties": {
            "pmd": {
              "type": "string"
            },
            "archunit": {
              "type": "string"
            },
            "jgit": {
              "type": "string"
            },
            "git": {
              "type": [
                "string",
                "null"
              ],
              "description": "네이티브 백엔드를 쓸 때만(§4.5, D17). JGit 단독이면 null."
            }
          },
          "additionalProperties": false
        },
        "classes_reproduction_inputs": {
          "type": "object",
          "description": "'원인'이 아니라 '클래스를 다시 만들려면 필요한 것'(§2.8). major.minor.patch.",
          "properties": {
            "jdk": {
              "type": "string"
            },
            "gradle": {
              "type": "string"
            },
            "kotlin": {
              "type": "string"
            },
            "compiler_args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "annotation_processors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dependency_lock": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "history_backend": {
          "type": "object",
          "description": "이력 백엔드(§4.5, D17). 기본 JGit 단독. 네이티브는 옵트인이고 백엔드가 다른 두 실행 사이의 델타·원장 전이는 거부한다.",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "enum": [
                "jgit",
                "native"
              ]
            },
            "git_version": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "window_applied": {
          "type": "object",
          "description": "창 W의 적용 결과(§2.7). 12개월 ∧ 2,000커밋 중 먼저 닥치는 상한.",
          "required": [
            "months",
            "max_commits",
            "bound_hit",
            "commits_in_window",
            "commit_list_sha256",
            "last_commit_map_sha256",
            "authors_window_truncated",
            "authors_window_days",
            "history_complete",
            "graft_boundary_shas"
          ],
          "properties": {
            "months": {
              "type": "integer"
            },
            "max_commits": {
              "type": "integer"
            },
            "bound_hit": {
              "enum": [
                "time",
                "count",
                "none"
              ],
              "description": "어느 상한이 먼저 걸렸나(§2.7)."
            },
            "commits_in_window": {
              "type": "integer"
            },
            "merge_commits_excluded": {
              "type": "integer",
              "description": "머지 커밋(부모 ≥ 2)은 세지 않는다(§2.7)."
            },
            "commit_list_sha256": {
              "type": "string",
              "description": "창 안 커밋 SHA 목록(순서 포함)의 해시(§2.8, D111). 목록 자체는 head + 창 규칙에서 재생성한다 — 그래서 목록 대신 해시만 인쇄한다."
            },
            "last_commit_map_sha256": {
              "type": "string",
              "description": "파일별 마지막 비머지 커밋 맵(경로 → SHA, 미커밋은 null)의 해시(§2.8, D146). `age_last_days`가 읽는 커밋은 창 밖일 수 있으므로(F의 후보가 그런 파일이다) 그 의존을 id 입력에 명시적으로 넣는다 — 커미터 시각은 커밋 객체의 일부이고 SHA는 그 객체 전체의 해시이므로, 나이를 바꿀 수 있는 모든 변화가 이 맵을 바꾼다. **창 안 SHA 목록의 전이적 봉인에 기대지 않는다** — 봉인은 완전한 클론에서만 참이다."
            },
            "history_complete": {
              "type": "boolean",
              "description": "이력이 완전한가 — `.git/shallow`가 없는가(§2.1, D148). **진단 필드이고 `analysis_input_id` 입력이 아니다**: shallow는 `last_commit_map_sha256`으로 이미 갈리므로 id에 또 넣으면 같은 사실을 두 번 세운다. false면 F 후보의 `age_last_days`는 `age_unknown`이다 — 감지하지 않으면 graft 경계가 파일의 탄생으로 읽혀 null이 아니라 그럴듯한 틀린 수가 나온다."
            },
            "graft_boundary_shas": {
              "type": "array",
              "items": { "type": "string" },
              "description": "graft 경계 커밋의 SHA 목록(§2.1, D148). 진단 필드이고 id 입력이 아니다. 완전한 클론에서는 빈 배열."
            },
            "authors_window_truncated": {
              "type": "boolean",
              "description": "90일 지표(`distinct_authors_90d`·`change_exposure_90d`)가 창 상한에 잘렸는가(§2.7·D137). **창의 속성이므로 여기 한 번만 적고 파일마다 적지 않는다** — 파일별 표기는 '이 파일이 잘린 구간에 커밋을 가졌나'를 아는 것처럼 읽히는데, 그 커밋들이 창에서 사라져 판정하는 것이므로 알 수 없다. '창이 90일보다 짧다'가 아니라 '상한이 90일 구간을 잘랐다'다 — 90일보다 어린 리포는 `false`다(볼 것이 없었다). 90일 ⊂ 12개월이므로 자를 수 있는 것은 개수 상한뿐이다."
            },
            "authors_window_days": {
              "type": "number",
              "minimum": 0,
              "maximum": 90,
              "description": "90일 지표가 실제로 본 일수 = `min(90, HEAD_TIME − 창의 가장 오래된 커밋 시각)`(§2.7·D137). 이름이 `90d`인데 실제로 1.6일을 본 경우를 아는 자리다. 0에서 자른다 — 커미터 시각이 뒤죽박죽이면(§2.1 `invalid_metadata`) HEAD가 자기 조상보다 이를 수 있고 그때 음수 일수는 아무 뜻이 없다."
            }
          },
          "additionalProperties": false
        },
        "bytecode_scope": {
          "type": "object",
          "description": "그래프 전처리 범위(§2.2). 테스트·`@Generated`·서드파티·JDK 제외. 외부 타입 간선은 `external` 의사 노드로 접어 기록하되 지표에서는 제외한다.",
          "properties": {
            "class_roots": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "test_classes_included": {
              "const": false,
              "description": "테스트 클래스는 그래프에 넣지 않는다(§2.2). O10에서 논의 중."
            },
            "generated_excluded": {
              "type": "boolean"
            },
            "external_edges": {
              "type": "integer",
              "description": "접힌 외부 간선 수 — 기록은 하되 Ca/Ce/I/A/D·CCD에서는 제외."
            },
            "external_included_in_metrics": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "component": {
          "type": "object",
          "description": "컴포넌트 전략의 결정 결과(§2.2, D15). 인쇄해서 재현 가능하게 한다.",
          "required": [
            "strategy",
            "count"
          ],
          "properties": {
            "strategy": {
              "type": "string",
              "description": "`module` / `auto` / `depth:<n>`(§2.2)."
            },
            "resolved_root": {
              "type": "string",
              "description": "`auto`가 고른 최장 공통 접두어(§2.2)."
            },
            "count": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "parameters": {
          "type": "object",
          "description": "모든 분석 파라미터(§2.8, §4.3). `scan`은 무설정이라 이 값들은 코드 기본값이고 전부 인쇄된다 — 설정 파일이 아니라 인쇄가 재현성의 근거다.",
          "additionalProperties": true
        },
        "percentile_method": {
          "type": "object",
          "description": "백분위·분위 방법(§2.5). 단일 방법 선언이다.",
          "required": [
            "rank",
            "formula",
            "quantile"
          ],
          "properties": {
            "rank": {
              "const": "average",
              "description": "동점 평균 순위(§2.5)."
            },
            "formula": {
              "const": "(rank_avg-1)/(N-1)"
            },
            "quantile": {
              "const": "type7-linear",
              "description": "type-7 선형 보간(Hyndman–Fan)(§2.5). 픽스처 예: `[1..9,100]`, q=0.9 → 18.1."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "spreadEntry": {
      "type": "object",
      "description": "모집단 분포(§2.5 표시 규칙) — 원값은 언제나 중앙값·IQR·최대와 함께 보인다.",
      "required": [
        "median",
        "iqr",
        "max"
      ],
      "properties": {
        "median": {
          "type": "number"
        },
        "iqr": {
          "type": "number",
          "description": "`IQR < 중앙값의 25%`면 `population_note`(§2.5). `IQR = 0`은 confidence를 low로 내린다(§3.7, D36)."
        },
        "max": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "p90": {
          "type": "number",
          "description": "F의 문턱(§3.3). type-7 분위, 유효값만(§2.5)."
        },
        "valid_n": {
          "type": "integer",
          "description": "값이 null이 아닌 항목 수(§2.5). `P90(age_last_days)`는 이 집합에서만 계산한다."
        },
        "unknown_n": {
          "type": "integer",
          "description": "값이 null인 항목 수. '오래되지 않았다'와 '나이를 모른다'는 다른 상태다(D37)."
        }
      },
      "additionalProperties": false
    },
    "populationStats": {
      "type": "object",
      "description": "한 모집단의 크기와 분포(§2.5).",
      "required": [
        "n"
      ],
      "properties": {
        "n": {
          "type": "integer"
        },
        "java": {
          "type": "integer",
          "description": "언어별 모집단 크기 — `cx` 백분위는 언어별로 계산한다(§2.5, D12)."
        },
        "kotlin": {
          "type": "integer"
        },
        "spread": {
          "type": "object",
          "description": "성분별 분포. 키는 성분 이름이거나 `<성분>.<언어>`(예: `cx.java`).",
          "additionalProperties": {
            "$ref": "#/$defs/spreadEntry"
          }
        }
      },
      "additionalProperties": false
    },
    "population": {
      "type": "object",
      "description": "모집단 셋과 커밋 거칠기(§2.5, §2.7).",
      "required": [
        "all",
        "active",
        "dx",
        "commit_granularity"
      ],
      "properties": {
        "all": {
          "$ref": "#/$defs/populationStats"
        },
        "active": {
          "$ref": "#/$defs/populationStats"
        },
        "dx": {
          "$ref": "#/$defs/populationStats"
