{
  "case": "report-history-incomplete-without-graft-boundary",
  "check": "schema",
  "kind": "hard_rule",
  "schema": "report.schema.json",
  "base": "prd:§7:report",
  "mechanism": "if/then",
  "contract_ref": "D148",
  "what": "`history_complete: false`면 graft 경계가 최소 하나 있다 — `.git/shallow`가 있다는 것이 경계가 있다는 뜻이다(D148). 경계를 인쇄하지 않으면 어느 커밋에서 이력이 끊겼는지 `reproduce`로 알 수 없다.",
  "patch": [
    {
      "op": "set",
      "path": [
        "reproduce",
        "window_applied",
        "history_complete"
      ],
      "value": false
    }
  ]
}
