{
  "case": "report-people-artifact-when-off",
  "check": "schema",
  "kind": "hard_rule",
  "schema": "report.schema.json",
  "base": "prd:§7:report",
  "mechanism": "if/then",
  "contract_ref": "D161",
  "what": "`off`인데 `people_artifact`가 `people.json`이다 → 거부(D161). off에서 저자 사실 파일이 있으면 계약 위반이고, report가 그 존재를 가리키는 것은 그 위반의 자백이다.",
  "patch": [
    {
      "op": "set",
      "path": [
        "people_artifact"
      ],
      "value": "people.json"
    }
  ]
}
